{
  "expo": {
    "name": "HADRO",
    "slug": "hadro",
    "version": "2.5.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hadro.mobile",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.hadro.mobile",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "scheme": "hadro",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HADRO to access your camera to scan office QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow HADRO to access your location to validate you are at the office for attendance."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HADRO to access your photos to set your profile picture.",
          "cameraPermission": "Allow HADRO to take a photo for your profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "enableFullScreenImage_legacy": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "releasePhase": "V2",
      "eas": {
        "projectId": "d96e8734-e3ea-42d1-a353-0018bce1b02d"
      }
    }
  }
}
